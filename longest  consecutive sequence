class Solution(object):
    def longestConsecutive(self, nums):
        s=set(nums)
        cnt=0
        maxi=0
        curr=0
        for nums in s:
            if  nums-1 not in s:
                curr=nums
                cnt=1
                while curr+1 in  s:
                    cnt+=1
                    curr+=1
           

            maxi=max(maxi,cnt)
        return maxi
            
    
